							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const body = pm.response.json();\r",
											"\r",
											"pm.environment.set(\"access_token\", body[\"access-token\"]);\r",
											"pm.environment.set(\"refresh_token\", body[\"refresh-token\"]);"
										],
										"type": "text/javascript"
									}
								}
							],
